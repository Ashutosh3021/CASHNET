# ============================================================================
# CASHNET Environment Configuration
# ============================================================================
# Synthetic mode is the default and requires no external credentials.
# Never commit real API keys or credentials to this file.

# Data provider mode: synthetic | public | user
CASHNET_DATA_MODE=synthetic

# Public data directory (for CSV/JSON/GeoJSON ingestion)
CASHNET_PUBLIC_DATA_DIR=./data/public

# Database
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# CORS: comma-separated list of allowed origins
# Production: https://cashnet-server.vercel.app
# Local dev: http://localhost:4173,http://localhost:5173
CORS_ORIGIN=

# Model Service (Python Flask)
# Production: https://cashnet-py.onrender.com
# Local dev: http://localhost:5000
PYTHON_SERVICE_URL=http://localhost:5000
MODELS_DIR=./models

# Security & PII Masking
ENABLE_PII_MASKING=true
LOG_MASKED_FIELDS=false

# JWT/Auth Token Configuration
JWT_SECRET=
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# Frontend Configuration (Vite build-time env vars)
# Production: https://cashnet-node.onrender.com
# Local dev: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# ============================================================================
# Blockchain Provider Configuration
# ============================================================================
# Bitcoin (Blockstream) is available by default - no key needed.
# Set these to enable additional blockchain providers.

# Ethereum (Etherscan API for transaction history)
ETHERSCAN_API_KEY=

# Ethereum RPC (for direct node access)
ETHEREUM_RPC_URL=

# Tron (Trongrid API)
TRON_API_KEY=

# Blockchair (multi-chain)
BLOCKCHAIR_API_KEY=

# ============================================================================
# External Integration Configuration
# ============================================================================
# NCRP and SAHYOG require authorized government API access.
# Do NOT set these unless you have official credentials.

NCRP_ENABLED=false
NCRP_API_URL=
NCRP_API_KEY=
NCRP_ORG_ID=
NCRP_CLIENT_ID=
NCRP_TIMEOUT=30

SAHYOG_ENABLED=false
SAHYOG_API_URL=
SAHYOG_API_KEY=
SAHYOG_CLIENT_ID=
SAHYOG_TIMEOUT=30

# VASP integration (optional)
VASP_ENABLED=false
VASP_API_URL=
VASP_API_KEY=
VASP_TIMEOUT=30

# ============================================================================
# Monitoring & Logging
# ============================================================================
SENTRY_DSN=
DATADOG_API_KEY=
LOG_TO_FILE=false

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_MODEL_PREDICTIONS=true
FEATURE_PII_MASKING=true
FEATURE_LEGAL_HOLD=true
FEATURE_AUDIT_TRAIL=true
FEATURE_BLOCKCHAIN_ANALYSIS=true

# Deployment Target (render/heroku/aws/gcp)
DEPLOYMENT_TARGET=render
